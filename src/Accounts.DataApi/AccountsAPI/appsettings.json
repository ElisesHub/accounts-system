{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http1" :
      {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc":{
        "Url":"https://+:8081",
        "Protocols" : "Http2"
      }
    }
  },
  "Auth0": {
    "Audience": "https://accounts-data-api"
  },
  "AllowedHosts": "*"
}